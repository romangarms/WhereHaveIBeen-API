# WhereHaveIBeen UserManagement API Configuration
# Copy this file to .env and fill in your actual values

# Flask Secret Key (generate with: python3 -c "import os; print(os.urandom(32).hex())")
SECRET_KEY=your-secret-key-here

# Server Port
PORT=5002

# Database Path (SQLite)
DATABASE_PATH=/data/users.db

# JWT Secret Key (MUST match the value in WhereHaveIBeen frontend .env)
# Generate with: python3 -c "import os; print(os.urandom(32).hex())"
JWT_SECRET_KEY=your-jwt-secret-key-here

# JWT Token Expiry (days)
JWT_EXPIRY_DAYS=30

# OwnTracks Recorder URL (internal Docker network)
OWNTRACKS_URL=http://owntracks-recorder:8083

# Note: OWNTRACKS_HTPASSWD_PATH is deprecated - ForwardAuth validates against SQLite

# Privileged OwnTracks credentials (for API proxy access)
# Create a dedicated "api" user in OwnTracks with access to all data
OWNTRACKS_PRIVILEGED_USER=api
OWNTRACKS_PRIVILEGED_PASS=secure-password-here

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
